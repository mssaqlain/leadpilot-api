# Optional. Leave OPENAI_API_KEY empty to run in demo mode (rule-based, no AI key needed).
# For live AI answers, copy this file to .env and fill in a key (Groq or any OpenAI-compatible API).
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
# Optional: every qualified lead is also POSTed to this webhook URL (n8n, Zapier)
LEAD_WEBHOOK_URL=
